<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane prefHeight="1080.0" prefWidth="1920.0" style="-fx-background-color: linear-gradient(to bottom right, #06245C 0%, #0B4FD6 55%, #2E8BFF 100%);" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.tela_gerenciamento_maquinas">
   <children>

      <!-- LOGO WattWise -->
      <StackPane layoutX="120.0" layoutY="56.0" prefHeight="84.0" prefWidth="84.0">
         <children>
            <Rectangle arcHeight="44.0" arcWidth="44.0" fill="WHITE" height="84.0" width="84.0" />
            <SVGPath content="M60 18 L28 60 H48 L42 88 L76 42 H56 Z" fill="#0B4FD6" scaleX="0.8" scaleY="0.8" />
         </children>
      </StackPane>
      <Label layoutX="228.0" layoutY="62.0" style="-fx-font-size: 56px; -fx-font-weight: bold; -fx-text-fill: white;" text="WattWise" />

      <!-- TÍTULO -->
      <Label layoutX="120.0" layoutY="180.0" style="-fx-font-size: 54px; -fx-font-weight: bold; -fx-text-fill: white;" text="Gerenciamento de Máquinas" />
      <Label layoutX="122.0" layoutY="252.0" style="-fx-font-size: 24px; -fx-text-fill: rgba(255,255,255,0.8);" text="Acompanhe e gerencie as máquinas cadastradas" />

      <!-- ÁREA CENTRAL BRANCA: as máquinas aparecem aqui -->
      <VBox layoutX="120.0" layoutY="330.0" prefHeight="530.0" prefWidth="1680.0" style="-fx-background-color: white; -fx-background-radius: 28;">
         <padding>
            <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
         </padding>
         <children>
            <ScrollPane fx:id="scrollMaquinas" fitToWidth="true" hbarPolicy="NEVER" prefHeight="506.0" prefWidth="1656.0" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="listaMaquinas" spacing="16.0">
                     <padding>
                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                     </padding>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </VBox>

      <!-- RODAPÉ -->
      <Button fx:id="btnVoltar" layoutX="120.0" layoutY="900.0" mnemonicParsing="false" onAction="#voltar" prefHeight="66.0" prefWidth="258.0" style="-fx-background-color: transparent; -fx-border-color: white; -fx-border-width: 2; -fx-border-radius: 16; -fx-background-radius: 16; -fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold; -fx-cursor: hand;" text="Voltar" />
      <Label fx:id="lblResumo" alignment="CENTER_RIGHT" layoutX="900.0" layoutY="916.0" prefHeight="34.0" prefWidth="900.0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" />
   </children>
</AnchorPane>
